{
  "manifest_version": 3,
  "name": "Não Seguidores Grátis - Removedor Automático",
  "version": "1.0.0",
  "description": "Descubra quem não te segue de volta no Instagram e deixe de seguir automaticamente de forma 100% segura e gratuita.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://*.instagram.com/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Abrir Não Seguidores Grátis"
  },
  "background": {
    "service_worker": "background.js"
  }
}
